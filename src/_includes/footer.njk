<footer class="site-footer">
  <div class="wrap">
    <div class="footer-cols">
      <div class="footer-brand">
        <a class="logo" href="{{ home }}">{{ site.name }}<span>{{ t.nav.subtitle }}</span></a>
        <p>{{ t.footer.tagline }}</p>
      </div>
      <div>
        <h2>{{ t.footer.practice_title }}</h2>
        <span>{{ site.address.street }}</span>
        <span>{{ site.address.city }}</span>
        <a class="route" href="https://www.google.com/maps/search/?api=1&amp;query={{ site.maps_query | urlencode }}">{{ t.footer.route }}</a>
      </div>
      <div>
        <h2>{{ t.footer.contact_title }}</h2>
        <a class="with-ico" href="tel:{{ site.phone.tel }}">{% include "icons/phone.njk" %}{{ site.phone.display }}</a>
        <a class="with-ico" href="tel:{{ site.mobile.tel }}">{% include "icons/mobile.njk" %}{{ site.mobile.display }}</a>
        <a class="with-ico" href="mailto:{{ site.email }}">{% include "icons/mail.njk" %}{{ site.email }}</a>
      </div>
      <div>
        <h2>{{ t.footer.hours_title }}</h2>
        {%- for line in t.footer.hours %}
        <span>{{ line }}</span>
        {%- endfor %}
      </div>
    </div>
    <div class="footer-bottom">
      <span>© <span id="year">{{ buildYear }}</span> {{ t.footer.copyright }}</span>
      <nav aria-label="{{ t.footer.legal_label }}">
        <a href="/impressum/">{{ t.footer.impressum }}</a>
        <a href="/datenschutz/">{{ t.footer.datenschutz }}</a>
        <a href="#">{{ t.footer.top }}</a>
      </nav>
    </div>
  </div>
</footer>
