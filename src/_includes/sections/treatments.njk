  <section class="section" id="angebote">
    <div class="wrap">
      <div class="treat-head">
        <div>
          <span class="eyebrow">{{ t.treatments.eyebrow }}</span>
          <h2>{{ t.treatments.title }}</h2>
        </div>
        <div class="tabs" role="tablist" aria-label="{{ t.treatments.eyebrow }}">
          {%- for item in t.treatments.items %}
          {%- set cfg = site.treatments[loop.index0] %}
          <button class="tab" role="tab" id="tab-{{ cfg.id }}" aria-controls="{{ cfg.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ item.tab }}</button>
          {%- endfor %}
        </div>
      </div>
      {% for item in t.treatments.items %}
      {%- set cfg = site.treatments[loop.index0] %}
      <article class="panel" id="{{ cfg.id }}" role="tabpanel" aria-labelledby="tab-{{ cfg.id }}" style="--dot: {{ cfg.dot }}">
        <div class="panel-top">
          <div class="panel-intro">
            <h3>{{ item.title }}</h3>
            <p class="lead">{{ item.lead | md | safe }}</p>
            {%- for p in item.paragraphs %}
            <p>{{ p | md | safe }}</p>
            {%- endfor %}
          </div>
          <div class="panel-side" style="background: var(--{{ cfg.panel }})">
            <h4>{{ t.treatments.prices_label }}</h4>
            {%- for price in item.prices %}
            <div class="price"><span class="eur">{{ price.price }}</span><span class="what">{{ price.label }}</span></div>
            {%- endfor %}
            {%- if item.note %}
            <p class="note">{{ item.note | md | safe }}</p>
            {%- endif %}
            <div><a class="btn" href="#kontakt">{{ t.treatments.cta }}</a></div>
          </div>
        </div>
        {%- if item.bodymap %}
        {%- set bm = item.bodymap %}
        {#- Point positions on the figure, in the order of bodymap.points -#}
        {%- set spots = [[100, 30], [100, 50], [100, 80], [100, 140], [115, 180], [100, 222], [87, 300]] %}
        <div class="infographic bodymap">
          <div class="info-head">
            <h4>{{ bm.title }}</h4>
            <p>{{ bm.intro }}</p>
          </div>
          <svg class="figure" viewBox="0 0 200 400" role="img" aria-label="{{ bm.image_label }}">
            <circle class="body" cx="100" cy="36" r="22"/>
            <path class="body" d="M90 56 L90 70 C72 74 58 80 54 96 C50 130 46 170 42 214 C41 221 48 223 50 216 C56 180 60 140 66 112 C68 150 70 190 71 222 C71 270 75 320 79 384 L95 384 C97 330 98 280 100 242 C102 280 103 330 105 384 L121 384 C125 320 129 270 129 222 C130 190 132 150 134 112 C140 140 144 180 150 216 C152 223 159 221 158 214 C154 170 150 130 146 96 C142 80 128 74 110 70 L110 56 Z"/>
            <path class="spine" d="M100 92 L100 208"/>
            {%- for p in bm.points %}
            {%- set xy = spots[loop.index0] %}
            {%- if xy %}
            <g class="spot">
              <circle cx="{{ xy[0] }}" cy="{{ xy[1] }}" r="9"/>
              <text x="{{ xy[0] }}" y="{{ xy[1] + 3.6 }}" text-anchor="middle">{{ loop.index }}</text>
            </g>
            {%- endif %}
            {%- endfor %}
          </svg>
          <ol class="legend">
            {%- for p in bm.points %}
            <li><span class="num" aria-hidden="true">{{ loop.index }}</span><span><strong>{{ p.label }}</strong>{{ p.text }}</span></li>
            {%- endfor %}
          </ol>
        </div>
        {%- endif %}
        {%- if item.process %}
        {%- set pr = item.process %}
        <div class="infographic process">
          <div class="info-head">
            <h4>{{ pr.title }}</h4>
            <p>{{ pr.intro }}</p>
          </div>
          <ol class="process-steps">
            {%- for s in pr.steps %}
            <li>
              <span class="step-num" aria-hidden="true">{{ loop.index }}</span>
              <strong>{{ s.title }}</strong>
              <span class="step-text">{{ s.text }}</span>
            </li>
            {%- endfor %}
          </ol>
          {%- if pr.loop %}
          <p class="process-loop"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66"/><path d="M20 4v5h-5"/></svg>{{ pr.loop }}</p>
          {%- endif %}
        </div>
        {%- endif %}
        {%- if item.stages %}
        {%- set st = item.stages %}
        <div class="infographic stages">
          <div class="info-head">
            <h4>{{ st.title }}</h4>
            <p>{{ st.intro }}</p>
          </div>
          <ol class="stage-line">
            {%- for s in st.items %}
            <li>
              <span class="node" aria-hidden="true"></span>
              <strong>{{ s.name }}</strong>
              <ul>{% for topic in s.topics %}<li>{{ topic }}</li>{% endfor %}</ul>
            </li>
            {%- endfor %}
          </ol>
        </div>
        {%- endif %}
        <div class="panel-bottom">
          <div>
            <h4>{{ item.when_title }}</h4>
            <p class="sub">{{ item.when_intro | md | safe }}</p>
            <ul class="symptoms">
              {%- for s in item.symptoms %}
              <li>{{ s }}</li>
              {%- endfor %}
            </ul>
          </div>
          <div class="faq">
            {%- for f in item.faq %}
            <details>
              <summary>{{ f.question }}</summary>
              <p>{{ f.answer | md | safe }}</p>
            </details>
            {%- endfor %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
