  {%- set p = t.praxis %}
  <section class="section praxis" id="praxis">
    <div class="wrap">
      <div class="praxis-intro">
        <span class="eyebrow">{{ p.eyebrow }}</span>
        <h2>{{ p.title }}</h2>
        <p class="lead">{{ p.lead | md | safe }}</p>
        {%- for para in p.paragraphs %}
        <p>{{ para | md | safe }}</p>
        {%- endfor %}
      </div>
      <div class="card">
        <h3>{{ p.card_title }}</h3>
        <dl>
          <div><dt>{{ p.address_label }}</dt><dd>{{ site.address.street }}<br>{{ site.address.city }}</dd></div>
          <div><dt>{{ p.phone_label }}</dt><dd><a class="with-ico" href="tel:{{ site.phone.tel }}">{% include "icons/phone.njk" %}{{ site.phone.display }}</a></dd></div>
          <div><dt>{{ p.mobile_label }}</dt><dd><a class="with-ico" href="tel:{{ site.mobile.tel }}">{% include "icons/mobile.njk" %}{{ site.mobile.display }}</a></dd></div>
          <div><dt>{{ p.email_label }}</dt><dd><a class="with-ico" href="mailto:{{ site.email }}">{% include "icons/mail.njk" %}{{ site.email }}</a></dd></div>
          <div><dt>{{ p.hours_label }}</dt><dd>{% for h in p.hours %}{{ h }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd></div>
        </dl>
        <p class="pay">{{ p.pay | md | safe }}</p>
      </div>
      <div class="map" id="map">
        <iframe title="{{ p.map_title }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps/embed?origin=mfe&amp;pb=!1m3!2m1!1s{{ site.maps_query | urlencode }}!6i15"></iframe>
      </div>
    </div>
  </section>
