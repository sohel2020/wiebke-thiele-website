  {%- set b = t.booking %}
  <section class="section booking" id="buchung">
    <div class="wrap">
      <div class="booking-intro">
        <span class="eyebrow">{{ b.eyebrow }}</span>
        <h2>{{ b.title }}</h2>
        <p class="lead">{{ b.lead }}</p>
        <h3 class="booking-sub">{{ b.overview_title }}</h3>
        <dl class="booking-list">
          {%- for item in t.treatments.items %}
          <div>
            <dt>{{ item.tab }}</dt>
            {%- for p in item.prices %}
            <dd><span>{{ p.label }}</span><span class="eur">{{ p.price }}</span></dd>
            {%- endfor %}
          </div>
          {%- endfor %}
        </dl>
      </div>
      <div class="booking-card">
        {%- if site.booking_url %}
        <div class="booking-consent" id="booking-consent">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4M8 14h3M8 17h6"/></svg>
          <p>{{ b.privacy }}</p>
          <button class="btn" type="button" id="booking-load">{{ b.load }}</button>
          <a class="link" href="{{ site.booking_url }}" target="_blank" rel="noopener">{{ b.open }}</a>
        </div>
        <div class="booking-frame" id="booking-frame" data-title="{{ b.frame_title }}" hidden></div>
        {%- else %}
        <div class="booking-consent">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4M8 14h3M8 17h6"/></svg>
          <h3>{{ b.coming_soon_title }}</h3>
          <p>{{ b.coming_soon }}</p>
        </div>
        {%- endif %}
        <p class="booking-phone">{{ b.phone_hint }}
          <a href="tel:{{ site.phone.tel }}">{{ site.phone.display }}</a> ·
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        </p>
      </div>
    </div>
  </section>
