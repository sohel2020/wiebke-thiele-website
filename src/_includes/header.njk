<header class="site-header">
  <div class="wrap">
    <a class="logo" href="{{ home }}">{{ site.name }}<span>{{ t.nav.subtitle }}</span></a>
    <nav class="nav" id="nav" aria-label="{{ t.nav.label }}">
      <a href="{{ home }}#osteopathie">{{ t.nav.osteopathie }}</a>
      <a href="{{ home }}#homoeopathie">{{ t.nav.homoeopathie }}</a>
      <a href="{{ home }}#frauengesundheit">{{ t.nav.frauengesundheit }}</a>
      <a href="{{ home }}#rhythmen">{{ t.nav.rhythmen }}</a>
      <a href="{{ home }}#about">{{ t.nav.about }}</a>
      <a href="{{ home }}#praxis">{{ t.nav.praxis }}</a>
      <a href="{{ home }}#kontakt">{{ t.nav.kontakt }}</a>
    </nav>
    <div class="header-actions">
      <nav class="lang-switch" aria-label="{{ t.nav.language }}">
        <a href="{% if isHome %}/{% else %}{{ page.url }}{% endif %}" lang="de" hreflang="de"{% if lang == "de" %} aria-current="page"{% endif %}>DE</a>
        <a href="/en/" lang="en" hreflang="en"{% if lang == "en" %} aria-current="page"{% endif %}>EN</a>
      </nav>
      <a class="header-cta" data-short="{{ t.nav.cta_short }}" href="{{ home }}#buchung">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4.5" width="14" height="12.5" rx="2"/><path d="M3 8.5h14M7 2.5v4M13 2.5v4"/></svg>
        <span>{{ t.nav.cta }}</span>
      </a>
      <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="nav">{{ t.nav.menu }}</button>
    </div>
  </div>
</header>
